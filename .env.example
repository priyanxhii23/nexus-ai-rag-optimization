# =====================================================================
# NEXUS AI — environment configuration TEMPLATE
# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is listed in .gitignore, so your real keys never reach GitHub.
# =====================================================================

# ---------- App ----------
APP_ENV=development            # development | test
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Storage ----------
SQLITE_PATH=data/nexus.db
CHROMA_PATH=data/chroma
DOCUMENTS_PATH=data/documents
MAX_UPLOAD_MB=20

# ---------- Embeddings ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Semantic cache ----------
CACHE_SIMILARITY_THRESHOLD=0.92   # safe default; tuned later in the Threshold Optimizer
CACHE_TTL_HOURS=72

# ---------- LLM providers (leave blank if you don't have one yet) ----------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional 3rd provider: any OpenAI-compatible endpoint.
# Example: Ollama running locally (free, no key needed)
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=ollama

# When true, LLM calls return clearly-labelled MOCK answers (no cost).
# Used by automated tests and for trying the UI before you have keys.
LLM_MOCK_MODE=false
