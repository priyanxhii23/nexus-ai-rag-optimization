# =====================================================================
# NEXUS AI - environment configuration TEMPLATE
# setup_windows.ps1 copies this file to ".env" (same folder) if .env is missing.
# ".env" is listed in .gitignore, so your real keys never reach GitHub.
# Never put API keys in frontend code or commit them anywhere.
# =====================================================================

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Storage (relative paths are inside the project folder) ----------
SQLITE_PATH=data/nexus.db
CHROMA_PATH=data/chroma
DOCUMENTS_PATH=data/documents
MAX_UPLOAD_MB=20

# ---------- Embeddings (downloaded once, ~90 MB, into data/models) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Semantic cache defaults (editable later in Settings) ----------
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=72

# ---------- LLM providers (leave blank if you don't have one yet) ----------
# Anthropic Claude: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Server-side refusal fallback for claude-opus-5-5 / claude-sonnet-5-5 (true/false)
ANTHROPIC_SERVER_FALLBACKS=true

# Google Gemini: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Gemini model IDs are not guessed. Pick them from Settings -> LLM providers -> "+"
# (the list comes from Google's API for your key) or write the IDs here.
GEMINI_SMALL_MODEL=
GEMINI_LARGE_MODEL=

# Optional 3rd provider: any OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio, OpenRouter ...)
# Example for a local Ollama:  OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1  OPENAI_COMPAT_MODEL=llama3.2
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# small | medium | large
OPENAI_COMPAT_TIER=small
# Prices per 1M tokens from the provider's pricing page (0 for a free local model). Blank = "unpriced".
OPENAI_COMPAT_INPUT_PRICE_PER_MTOK=
OPENAI_COMPAT_OUTPUT_PRICE_PER_MTOK=

# auto  = TEST MODE (labelled mock answers) only when no provider is configured  (recommended)
# true  = always TEST MODE (no API cost)
# false = never mock; questions fail with a clear message if no provider works
LLM_MOCK_MODE=auto
LLM_TIMEOUT_SECONDS=60
