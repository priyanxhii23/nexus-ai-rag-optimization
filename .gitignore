# ---------- Secrets (NEVER commit) ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
*.log
npm-debug.log*

# ---------- Local data (your private documents & databases) ----------
data/documents/*
!data/documents/.gitkeep
data/chroma/
data/models/
data/logs/
data/*.db-wal
data/*.db-shm
data/*.db
data/*.sqlite
backend/*.db

# Benchmark datasets ship in backend/app/evaluation/datasets/; generated outputs are not committed
data/benchmarks/*
!data/benchmarks/.gitkeep

# Hugging Face / sentence-transformers model cache
.cache/
models_cache/

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
setup-log.txt

# Windows script logs / pid files
*.pid

# Release archives
*.zip
